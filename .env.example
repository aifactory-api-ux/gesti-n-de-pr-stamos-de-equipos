# ==============================================================================
# SISTEMA DE GESTIÓN DE PRÉSTAMOS DE EQUIPOS TI — APIUX
# Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Base de Datos PostgreSQL 15
# ------------------------------------------------------------------------------
# Credenciales y conexión relacional conforme a ISO 27001 y políticas ACID
DB_HOST=localhost
DB_PORT=25432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=prestamos_apiux

# Compatibilidad TypeORM DataSource
DATABASE_HOST=localhost
DATABASE_PORT=25432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=prestamos_apiux
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 2. Configuración del Servidor Backend (NestJS)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
BACKEND_PORT=23000
GLOBAL_PREFIX=api/v1
CORS_ORIGIN=http://localhost:23080,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Configuración del Frontend SPA (React + Vite + Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=23080
VITE_API_URL=http://localhost:23000/api/v1

# ------------------------------------------------------------------------------
# 4. Seguridad Criptográfica y Tokens JWT (ISO 27001)
# ------------------------------------------------------------------------------
# Clave simétrica de firma HMAC-SHA256 para tokens JWT emitidos
JWT_SECRET=clave-secreta-jwt-super-segura-apiux-2026-min32caracteres
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------------------------
# 5. Autenticación Azure Active Directory (MSAL / SSO)
# ------------------------------------------------------------------------------
AZURE_TENANT_ID=a8947e4b-76b3-469b-871d-5582bf4ad391
AZURE_CLIENT_ID=3f87b8f9-906d-495c-9db6-7cbdfa024cb5
AZURE_CLIENT_SECRET=dummy_client_secret_for_mock_and_dev
VITE_AZURE_TENANT_ID=a8947e4b-76b3-469b-871d-5582bf4ad391
VITE_AZURE_CLIENT_ID=3f87b8f9-906d-495c-9db6-7cbdfa024cb5
VITE_AZURE_REDIRECT_URI=http://localhost:23080

# ------------------------------------------------------------------------------
# 6. Servicio de Correo SMTP y Notificaciones ITIL
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Apiux TI Préstamos" <notificaciones-ti@apiux.com>
